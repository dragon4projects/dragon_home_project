extends SceneTree
const REG=preload("res://scripts/dense_v2_artifact_grid_registry.gd")
func _initialize()->void:
 var registry=REG.new()
 assert(registry.initialize())
 assert(registry.supports.size()==8)
 var keys:Array=registry.supports.keys()
 var a:String=keys[0]
 var b:String=keys[1]
 assert(registry.reserve("large",a,"L",Vector2i.ZERO))
 assert(registry.reserve("occupied",b,"L",Vector2i.ZERO))
 var before:Dictionary=registry.snapshot()
 assert(not registry.move("large",b,Vector2i.ZERO))
 assert(registry.snapshot()==before)
 assert(not registry.replace("large",[{"id":"occupied","size":"M","at":Vector2i.ZERO}]))
 assert(registry.snapshot()==before)
 assert(registry.replace("large",[{"id":"medium","size":"M","at":Vector2i.ZERO},{"id":"small1","size":"S","at":Vector2i(2,0)},{"id":"small2","size":"S","at":Vector2i(2,1)}]))
 assert(registry.grids[a].free_cells()==0)
 assert(registry.placement("medium").dimensions[0]>.34)
 assert(registry.placement("small1").grid_id==a)
 assert(registry.release("occupied"))
 assert(registry.move("medium",b,Vector2i.ZERO))
 assert(registry.grids[a].free_cells()==4 and registry.grids[b].free_cells()==2)
 var snap:Dictionary=registry.snapshot()
 var loaded=REG.new()
 assert(loaded.initialize() and loaded.restore(JSON.parse_string(JSON.stringify(snap))))
 assert(loaded.snapshot()==snap)
 var corrupt:Dictionary=snap.duplicate(true)
 corrupt.grids[b].allocations.append({"id":"small1","size":"S","at":[2,0],"turn":false})
 assert(not loaded.restore(corrupt) and loaded.snapshot()==snap)
 var wrong:Dictionary=snap.duplicate(true)
 wrong.revision="wrong"
 assert(not loaded.restore(wrong) and loaded.snapshot()==snap)
 print("DENSE_V2_ARTIFACT_REGISTRY_PASS grids=",registry.supports.size()," atomic_replace_move=true duplicate_rejected=true revision_guard=true")
 quit()
