extends SceneTree
const GRID=preload("res://scripts/artifact_cell_grid.gd")
func _initialize()->void:
 var grid=GRID.new(3,2)
 assert(grid.reserve("L","L",Vector2i.ZERO))
 assert(grid.free_cells()==0 and grid.occupied.size()==6)
 assert(not grid.reserve("overflow","S",Vector2i.ZERO))
 assert(grid.replace("L",[{"id":"M","size":"M","at":Vector2i.ZERO},{"id":"S1","size":"S","at":Vector2i(2,0)},{"id":"S2","size":"S","at":Vector2i(2,1)}]))
 assert(grid.occupied.size()==6 and grid.allocations.size()==3)
 var before:Dictionary=grid.snapshot()
 assert(not grid.replace("M",[{"id":"bad","size":"L","at":Vector2i.ZERO}]))
 assert(grid.snapshot()==before)
 var copy=GRID.new(3,2)
 assert(copy.restore(JSON.parse_string(JSON.stringify(before))))
 assert(copy.snapshot()==before)
 var bad=before.duplicate(true)
 bad.allocations.append({"id":"collision","size":"S","at":[0,0],"turn":false})
 assert(not copy.restore(bad) and copy.snapshot()==before)
 assert(copy.release("S1") and copy.free_cells()==1)
 var rotated=GRID.new(2,3)
 assert(rotated.reserve("L","L",Vector2i.ZERO,true))
 print("ARTIFACT_CELL_GRID_PASS 6=4+1+1 atomic_replacement=true rotation=true snapshot=true")
 quit()
