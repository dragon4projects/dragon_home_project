extends SceneTree
const W=preload("res://scripts/world_model.gd")
const N=preload("res://scripts/teea008_navigation.gd")
const B=preload("res://scripts/teea008_review_bank.gd")
const M=preload("res://scripts/media_runtime.gd")
const R=preload("res://scripts/teea008_media_bindings.gd")
func _initialize()->void:call_deferred("run")
func run()->void:
	OS.set_environment("DRAGON_TEEA008_REVIEW","1")
	var w=W.new()
	w.save_path="user://teea008_artifact_support.json"
	w.seed_world()
	var bank=B.new()
	assert(bank.initialize())
	var nav=N.new()
	nav.configure(bank.layouts)
	var media=M.new()
	media.setup(w)
	var bind=R.new()
	bind.setup(w,bank,media)
	var room:Dictionary=w.get_room(1,-1)
	var rid:String=room["id"]
	var surface:="artifact.r1.label.01"
	assert(w.register_physical_object("QA_ART","QA artifact","RES_01",rid,true,true,false,false,true,{"viewer_category":"artifacts","home_anchor":[0.0,0.7],"display_world_height":0.12}))
	assert(not bind.place_artifact(rid,surface,"QA_ART",nav,2.0,2.0,0.04))
	var placed:bool=bind.place_artifact(rid,surface,"QA_ART",nav,0.1,0.12,0.04)
	assert(placed)
	var obj:Dictionary=w.physical_object("QA_ART")
	var slot:String=str(obj.get("home_support_id",""))
	assert(slot!="")
	assert(nav.artifact_support(room,slot)["furniture_id"]=="artifact_r1_shelf_a")
	assert(obj["canonical_owner_id"]=="RES_01")
	assert(obj["current_support_id"]==slot)
	assert(not w.object_is_displaced(obj))
	assert(bind.resolve(rid,surface)["id"]=="QA_ART")
	assert(w.save_world())
	var restored=W.new()
	restored.save_path=w.save_path
	restored.load_or_seed()
	assert(restored.physical_object("QA_ART")["home_support_id"]==slot)
	assert(restored.physical_object("QA_ART")["canonical_owner_id"]=="RES_01")
	assert(restored.physical_object("QA_ART")["current_support_id"]==slot)
	var actor:Dictionary=restored.residents["RES_01"]
	actor["room_id"]=rid
	var before:Dictionary=restored.physical_object("QA_ART")
	var same_xz:Array=before["home_anchor"].duplicate()
	assert(restored.pickup_physical_object("QA_ART","RES_01"))
	assert(restored.place_physical_object("QA_ART","RES_01",rid,"PLACED",same_xz))
	assert(restored.object_is_displaced(restored.physical_object("QA_ART")))
	assert(restored.restore_physical_object_home("QA_ART"))
	assert(restored.physical_object("QA_ART")["current_support_id"]==slot)
	assert(not restored.object_is_displaced(restored.physical_object("QA_ART")))
	assert(restored.assign_physical_object_home("QA_ART",rid,Vector2(0,0.8),true))
	assert(not restored.physical_object("QA_ART").has("home_support_id"))
	print("TEEA008_ARTIFACT_SUPPORT_PASS exact_slot=true oversized_denied=true replay=true owner_preserved=true")
	quit(0)
