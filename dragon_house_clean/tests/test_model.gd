extends SceneTree
const WorldScript = preload("res://scripts/world_model.gd")
const LifeScript = preload("res://scripts/life.gd")

func _initialize() -> void:
	var model = WorldScript.new()
	model.save_path = "user://test_model_world_only.json"
	model.seed_world()
	assert(model.rooms.size() == 19, "Initial map must be 19 physical rooms")
	assert(model.residents.size() == 25, "24 canonical slots + Manjka")
	assert(model.residents["RES_24"]["name"] == "Язвочка")
	assert(model.residents["RES_24"]["appearance_profile"] == "LISA_01")
	assert(model.residents["RES_24"]["active"] == false, "Never invent unavailable identity")
	var core: Dictionary = model.get_room(-2, 0)
	assert(not core.is_empty())
	assert(core["id"] == model.get_room(-1,0)["id"])
	assert(core["id"] == model.get_room(0,0)["id"])
	assert(model.room_size_modules(core) == 3 and core["size_id"] == "R3")
	assert(bool(core["immutable_topology"]))
	assert(not model.can_reconfigure_room(core["id"]))
	assert(model.merged_run_length(-2, 0) == 3, "Common is one physical R3 room")
	var upper: Dictionary = model.get_room(4, 1)
	var route: Array = model.find_route(core["id"], upper["id"], "MANJKA")
	assert(route.size() > 3, "Navigation must reach upper band through connector lift")
	var priv: Dictionary = model.get_room(3, 1)
	assert(model.find_route(core["id"], priv["id"], "MANJKA").is_empty(),
		"Private room must not become an interior destination")
	assert(not model.build_room(3, 1, "library",1), "Cannot overwrite immutable private room")
	assert(not model.build_room(10, 5, "music",2), "Cannot create isolated room")
	assert(model.build_room(6, 0, "workshop",2), "R2 expansion should attach to lift")
	var workshop_r2:Dictionary=model.get_room(6,0)
	assert(workshop_r2["id"]==model.get_room(7,0)["id"])
	assert(model.room_size_modules(workshop_r2)==2 and workshop_r2["size_id"]=="R2")
	assert(not bool(workshop_r2["immutable_topology"]))
	assert(model.build_room(8,0,"workshop",1), "A separate R1 may connect to the R2")
	var workshop_r1:Dictionary=model.get_room(8,0)
	assert(workshop_r1["id"]!=workshop_r2["id"])
	assert(model.room_size_modules(workshop_r2)==2,
		"Adding a neighbor must never resize/rebuild an existing room")
	var life = LifeScript.new()
	life.setup(model)
	for i in range(180):
		life.tick(1.0)
	assert(life.steps > 1, "Autonomous plan scheduler must make choices")
	assert(life.log.size() > 0, "Human-readable house log must exist")
	assert(model.media["films"].is_empty(), "Do not fabricate film catalog")
	for suffix in ["",".bak",".tmp"]:
		DirAccess.remove_absolute(ProjectSettings.globalize_path(model.save_path+suffix))
	print("DRAGON_HOUSE_MODEL_TEST_PASS physical_rooms=21 seed=19 common=R3 immutable route=",
		route.size()," autonomy_actions=",life.steps)
	quit(0)
